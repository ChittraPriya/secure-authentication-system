# --- Database (SQLite for local dev; switch provider to postgresql for production) ---
DATABASE_URL="file:./dev.db"

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
OTP_PEPPER="change-me-to-another-long-random-string"

# --- WebAuthn (optional; auto-detected from the request host when empty) ---
# RP_ID="localhost"
# APP_ORIGIN="http://localhost:3000"
RP_NAME="OneKey"

# --- Dev convenience: show the OTP on screen when no SMTP/SMS provider is configured ---
DEV_SHOW_OTP="true"

# --- Email delivery (optional; leave empty for dev mode). Check with: npm run email:test -- you@gmail.com ---
#   Gmail:  SMTP_HOST=smtp.gmail.com        SMTP_PORT=465  SMTP_USER=your Gmail address
#           SMTP_PASS=16-char App Password from myaccount.google.com/apppasswords (NOT your Gmail password)
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=the "Login" on Brevo → SMTP & API → SMTP
#           SMTP_PASS=an SMTP key from that same tab (NOT the xkeysib- API key)
#   MAIL_FROM must be an address you're allowed to send from (for Brevo: a verified sender).
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# --- SMS delivery via Brevo (optional; used first when set) ---
# API key: Brevo dashboard → SMTP & API → API keys. Sender: up to 11 letters/digits.
# BREVO_API_KEY=""
# BREVO_SMS_SENDER="OneKey"

# --- SMS delivery via Twilio (optional; used if Brevo is not set) ---
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
