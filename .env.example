# --- Database (SQLite for local dev; switch provider to postgresql for production) ---
DATABASE_URL="file:./dev.db"

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
OTP_PEPPER="change-me-to-another-long-random-string"

# --- WebAuthn (optional; auto-detected from the request host when empty) ---
# RP_ID="localhost"
# APP_ORIGIN="http://localhost:3000"
RP_NAME="OneKey"

# --- Dev convenience: show the OTP on screen when no SMTP/SMS provider is configured ---
DEV_SHOW_OTP="true"

# --- Email delivery (optional) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@example.com"
# SMTP_PASS="app-password"
# MAIL_FROM="OneKey <you@example.com>"

# --- SMS delivery via Twilio (optional) ---
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
