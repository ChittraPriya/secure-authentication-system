{
  "name": "onekey-auth",
  "version": "1.0.0",
  "private": true,
  "description": "Passwordless auth: email/phone sign-up, 6-digit OTP, Face ID / biometric passkeys, single active device.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "email:test": "node --env-file=.env scripts/test-email.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@simplewebauthn/browser": "13.1.0",
    "@simplewebauthn/server": "13.1.1",
    "jose": "5.9.6",
    "next": "15.1.6",
    "nodemailer": "6.9.16",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
